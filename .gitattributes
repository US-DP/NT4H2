# Normalización de finales de línea y binarios.
# El repo se desarrolla en Windows pero los tests/CI esperan LF.

* text=auto eol=lf

# Scripts de shell de Windows conservan CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binarios
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.mp3 binary
*.wav binary
*.ogg binary
