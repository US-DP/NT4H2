# ============================================================================
# NT4H Digital — variables de entorno de ejemplo
#
# Copia a .env (o exporta) solo lo que necesites. TODO tiene fallback seguro
# en desarrollo; en producción las variables marcadas (PROD) son obligatorias.
# ============================================================================

# --- Backend Django (apps/backend) -------------------------------------------

# (PROD) Clave secreta de Django. Genera una: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# Desarrollo: DJANGO_DEBUG=true. En producción debe ser False o ausente.
DJANGO_DEBUG=false

# Hosts permitidos (CSV).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Forzar HTTPS detrás del proxy (PROD: true).
SECURE_SSL_REDIRECT=false

# Orígenes CORS permitidos (CSV). Vacío = sin CORS cross-origin.
CORS_ALLOWED_ORIGINS=

# PostgreSQL (PROD recomendado). Vacío = SQLite local.
#DATABASE_URL=postgres://user:pass@host:5432/nt4h
# Ruta de SQLite alternativa (solo si no hay DATABASE_URL).
#SQLITE_PATH=db.sqlite3

# Channel layer de producción (PROD: obligatorio para multi-worker).
#REDIS_URL=redis://localhost:6379/0

# Secreto compartido backend → engine-runner (PROD: obligatorio).
ENGINE_RUNNER_TOKEN=

# Bearer para GET /api/metrics/ (sin él solo responde a localhost).
#METRICS_TOKEN=


# URL del servicio de partidas online.
ENGINE_RUNNER_URL=http://localhost:3001

# Límite global de peticiones por minuto (por IP y scope).
#ROOM_RATE_LIMIT_MAX=

# IPs de proxies confiables para X-Forwarded-For (CSV).
#TRUSTED_PROXY_IPS=

# Token Bearer para escrituras de contenido (POST/PUT/DELETE /api/cards*).
#CONTENT_API_TOKEN=

# Política de ciclo de vida de salas.
#ROOM_WAITING_GC_MINUTES=30
#ROOM_PLAYING_GC_HOURS=48
#ROOM_FINISHED_GC_HOURS=24

# --- Engine runner (apps/engine-runner) --------------------------------------

# (PROD) Mismo secreto que ENGINE_RUNNER_TOKEN del backend.
#ENGINE_RUNNER_TOKEN=

# Puerto HTTP del runner.
#ENGINE_RUNNER_PORT=3001

# Directorio de snapshots por sala (sin él, el runner es memoria pura).
#ENGINE_RUNNER_STATE_DIR=./state

# Solo desarrollo: permite arrancar sin ENGINE_RUNNER_TOKEN.
#ENGINE_RUNNER_DEV_OPEN=1

# --- App móvil / web (apps/mobile) -------------------------------------------

# DSN de Sentry para la app (opcional; vacío = telemetría desactivada).
#EXPO_PUBLIC_SENTRY_DSN=
