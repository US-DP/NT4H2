{
  "name": "@nt4h/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo export --platform web --dev",
    "build": "expo export --platform web",
    "start": "expo start",
    "web": "expo start --web",
