    "@nt4h/schema": "workspace:*",
    "expo": "~53.0.0",
    "expo-image": "~2.0.0",
    "expo-router": "~4.0.0",
    "expo-sqlite": "~15.0.0",
    "expo-status-bar": "~2.0.0",
    "immer": "^10.0.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.0",
    "react-native-web": "~0.20.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "9.18.0",
    "@playwright/test": "^1.62.1",
    "@types/react": "~19.0.0",
    "eslint": "9.18.0",
    "eslint-plugin-react": "7.37.4",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-security": "3.0.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "8.20.0",
    "vitest": "^2.1.9"
