{
  "name": "@nt4h/engine-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "tsx server.ts",
    "lint": "tsc --noEmit",
    "test": "tsx --test server.test.ts server-negative.test.ts server-positive.test.ts server-audit.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nt4h/engine": "workspace:*",
    "@nt4h/catalog": "workspace:*",
    "@nt4h/schema": "workspace:*",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
