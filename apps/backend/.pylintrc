[MASTER]
load-plugins = pylint_django
django-settings-module = backend.settings
ignore = migrations

[MESSAGES CONTROL]
disable =
    missing-module-docstring,
    missing-class-docstring,
    missing-function-docstring,
    too-few-public-methods,
    # DRF ViewSets heredan de clases profundas por diseño
    too-many-ancestors,
    unused-argument,
    too-many-arguments,
    too-many-locals,
    duplicate-code,
    # Channels: django.setup() debe ejecutarse antes de importar routing (asgi.py)
    wrong-import-position,
    # imports locales deliberados dentro de funciones sync_to_async / tests
    import-outside-toplevel,
    # Channels consumer: atributos de instancia se crean en connect()
    attribute-defined-outside-init,
    # overrides de AsyncJsonWebsocketConsumer con firmas propias de Channels
    arguments-renamed,
    arguments-differ,
    # endpoints de validación con guard clauses: un return por check es
    # más legible que encadenar elif
    too-many-return-statements,
    # tests.py crece con la suite; dividir clases de test no aporta
    too-many-lines,
    too-many-public-methods,
    # consumers/vistas REST con guard clauses: los umbrales de complejidad
    # ya los gobierna scripts/check-complexity.py (WARN >800 / FAIL >1500 LOC)
    too-many-instance-attributes,
    too-many-boolean-expressions,
    too-many-branches,
    too-many-statements,
    # imports locales deliberados en tests (django.test.Client/patch por test)
    reimported,
    redefined-outer-name,

[FORMAT]
max-line-length = 120
